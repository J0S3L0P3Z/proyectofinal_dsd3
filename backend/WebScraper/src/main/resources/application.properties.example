# COPIA DE EJEMPLO (sí se sube a git, sin contraseñas).
# Para usarla: copiar este archivo como application.properties en esta misma carpeta
# y poner la IP, el esquema, el usuario y la contraseña de la base de datos.

spring.config.import=optional:file:.env[.properties]
spring.application.name=WebScraper

# Base de datos del profesor: cambien IP, esquema, usuario y contraseña por los suyos.
# Los parámetros del final de la URL evitan errores de zona horaria y de conexión con MySQL 8.
spring.datasource.url=jdbc:mysql://IP_DEL_SERVIDOR:3306/TU_ESQUEMA?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=TU_USUARIO
spring.datasource.password=TU_CONTRASENA
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

server.port=${PORT:8080}
server.forward-headers-strategy=${FORWARD_HEADERS_STRATEGY:none}
server.error.include-stacktrace=never
server.error.include-message=never
spring.jackson.default-property-inclusion=non_null

jwt.secret=${JWT_SECRET}
jwt.expiration-minutes=${JWT_EXPIRATION_MINUTES:60}

aes.key=${AES_KEY}
aes.iv=${AES_IV}

spring.mail.host=${SMTP_HOST:localhost}
spring.mail.port=${SMTP_PORT:1025}
spring.mail.username=${SMTP_USER:}
spring.mail.password=${SMTP_PASSWORD:}
spring.mail.properties.mail.smtp.auth=${SMTP_AUTH:false}
spring.mail.properties.mail.smtp.starttls.enable=${SMTP_STARTTLS:false}
spring.mail.properties.mail.smtp.connectiontimeout=10000
spring.mail.properties.mail.smtp.timeout=15000
spring.mail.properties.mail.smtp.writetimeout=15000

logging.level.root=${LOG_LEVEL:INFO}
logging.level.co.edu.unbosque.webscraper=${APP_LOG_LEVEL:INFO}
logging.pattern.console=%d{HH:mm:ss.SSS} %-5level [%X{jobId:-}|%X{step:-}] %logger{25} - %msg%n

app.frontend-url=${FRONTEND_URL:http://localhost:4200}
app.frontend-history-path=${FRONTEND_HISTORY_PATH:/history}
app.frontend-verify-email-path=${FRONTEND_VERIFY_EMAIL_PATH:/verify-email}
app.frontend-reset-password-path=${FRONTEND_RESET_PASSWORD_PATH:/reset-password}
app.public-url=${PUBLIC_URL:}
app.cors-allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:4200}
app.timezone=${APP_TIMEZONE:America/Bogota}

app.auth.require-email-verification=${REQUIRE_EMAIL_VERIFICATION:false}
app.auth.reset-token-minutes=${RESET_TOKEN_MINUTES:30}
app.auth.verification-token-hours=${VERIFICATION_TOKEN_HOURS:24}

app.seed.admin-username=${SEED_ADMIN_USERNAME:}
app.seed.admin-email=${SEED_ADMIN_EMAIL:}
app.seed.admin-password=${SEED_ADMIN_PASSWORD:}
app.seed.demo-username=${SEED_DEMO_USERNAME:}
app.seed.demo-email=${SEED_DEMO_EMAIL:}
app.seed.demo-password=${SEED_DEMO_PASSWORD:}

app.mail.from=${MAIL_FROM:no-reply@webscraper.local}
app.mail.enabled=${MAIL_ENABLED:true}
app.mail.retries=${MAIL_RETRIES:2}

app.scraping.timeout-seconds=${SCRAPE_TIMEOUT_SECONDS:30}
app.scraping.settle-seconds=${SCRAPE_SETTLE_SECONDS:5}
app.scraping.max-concurrent=${SCRAPE_MAX_CONCURRENT:2}
app.scraping.queue-capacity=${SCRAPE_QUEUE_CAPACITY:20}
app.scraping.global-timeout-minutes=${SCRAPE_GLOBAL_TIMEOUT_MINUTES:6}
app.scraping.block-resources=${SCRAPE_BLOCK_RESOURCES:true}
app.scraping.chromium-no-sandbox=${SCRAPE_CHROMIUM_NO_SANDBOX:false}
app.scraping.network-guard=${SCRAPE_NETWORK_GUARD:true}
app.scraping.chrome-binary=${CHROME_BIN:}
app.scraping.chromedriver-path=${CHROMEDRIVER_PATH:}
app.scraping.user-agent=${SCRAPE_USER_AGENT:Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36 WebScraperUniversidad/0.1}
app.scraping.max-active-per-user=${SCRAPE_MAX_ACTIVE_PER_USER:3}

app.ai.max-input-tokens=${AI_MAX_INPUT_TOKENS:12000}
app.ai.content-format=${AI_CONTENT_FORMAT:HTML}
app.ai.max-retries=${AI_MAX_RETRIES:1}
app.ai.timeout-seconds=${AI_TIMEOUT_SECONDS:150}
app.ai.http-timeout-seconds=${AI_HTTP_TIMEOUT_SECONDS:60}
app.ai.final-summary=${AI_FINAL_SUMMARY:true}

app.ai.providers.ollama.base-url=${AI_OLLAMA_BASE_URL:https://ollama.com/v1}
app.ai.providers.ollama.api-key=${AI_OLLAMA_API_KEY:}
app.ai.providers.ollama.model=${AI_OLLAMA_MODEL:gemma4:31b}
app.ai.providers.ollama.fallback-model=${AI_OLLAMA_FALLBACK_MODEL:}
app.ai.providers.ollama.max-concurrent=1

app.ai.providers.gemini.base-url=${AI_GEMINI_BASE_URL:https://generativelanguage.googleapis.com/v1beta/openai}
app.ai.providers.gemini.api-key=${AI_GEMINI_API_KEY:}
app.ai.providers.gemini.model=${AI_GEMINI_MODEL:gemini-3.5-flash-lite}
app.ai.providers.gemini.fallback-model=${AI_GEMINI_FALLBACK_MODEL:}
app.ai.providers.gemini.max-concurrent=2

app.ai.providers.openrouter.base-url=${AI_OPENROUTER_BASE_URL:https://openrouter.ai/api/v1}
app.ai.providers.openrouter.api-key=${AI_OPENROUTER_API_KEY:}
app.ai.providers.openrouter.model=${AI_OPENROUTER_MODEL:nvidia/nemotron-3-ultra-550b-a55b:free}
app.ai.providers.openrouter.fallback-model=${AI_OPENROUTER_FALLBACK_MODEL:}
app.ai.providers.openrouter.max-concurrent=2

springdoc.api-docs.enabled=${SWAGGER_ENABLED:true}
springdoc.swagger-ui.enabled=${SWAGGER_ENABLED:true}
springdoc.swagger-ui.path=/
springdoc.swagger-ui.docExpansion=none
springdoc.swagger-ui.syntaxHighlight.activated=true
springdoc.swagger-ui.syntaxHighlight.theme=markdown
springdoc.swagger-ui.displayRequestDuration=true
springdoc.swagger-ui.filter=true
springdoc.swagger-ui.tryItOutEnabled=true
springdoc.swagger-ui.persistAuthorization=true
springdoc.swagger-ui.supportedSubmitMethods=["get", "post", "put", "delete"]
springdoc.swagger-ui.disable-swagger-default-url=true
